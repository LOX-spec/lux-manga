{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public-build",
  "functions": {
    "api/mangadex.js": {
      "maxDuration": 30
    },
    "api/comick.js": {
      "maxDuration": 15
    },
    "api/page.js": {
      "includeFiles": "*.{html,js,css,svg}"
    },
    "api/source.js": {
      "maxDuration": 45
    },
    "api/image.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "novels"
        }
      ],
      "destination": "/api/page"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "novel"
        }
      ],
      "destination": "/api/page"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "reader"
        }
      ],
      "destination": "/api/page"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "admin"
        }
      ],
      "destination": "/api/page"
    },
    {
      "source": "/novels",
      "destination": "/api/page?view=novels"
    },
    {
      "source": "/admin",
      "destination": "/api/page?view=admin"
    },
    {
      "source": "/novel/:id",
      "destination": "/api/page?view=novel&id=:id"
    },
    {
      "source": "/reader/:id/:chapter",
      "destination": "/api/page?view=reader&id=:id&chapter=:chapter"
    },
    {
      "source": "/reader/:id",
      "destination": "/api/page?view=reader&id=:id"
    },
    {
      "source": "/:path((?!api(?:/|$)|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
